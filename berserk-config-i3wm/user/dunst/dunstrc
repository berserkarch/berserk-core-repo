[global]

### Display
monitor = 0
follow = none
origin = top-right
offset = 40x40
scale = 0
notification_limit = 12

### Geometry
width = 420
height = 120
gap_size = 5
padding = 20
horizontal_padding = 20
text_icon_padding = 20
frame_width = 2
separator_height = 10
separator_color = frame
corner_radius = 0

### Progress Bar
progress_bar = true
progress_bar_height = 5
progress_bar_frame_width = 0
progress_bar_min_width = 150
progress_bar_max_width = 300

### Behavior
indicate_hidden = yes
sort = yes
idle_threshold = 120
stack_duplicates = true
hide_duplicate_count = false
transparency = 0

### Text
font = "Iosevka 11"
line_height = 2
markup = full
format = "%s %n %b"
alignment = left
vertical_alignment = center
show_age_threshold = 60
ellipsize = end
ignore_newline = no
show_indicators = no

### Icons
enable_recursive_icon_lookup = true
# Match the system-wide icon theme (GTK 2/3/4, qt5ct/qt6ct, dconf all use this).
# With enable_recursive_icon_lookup, icon_theme takes a freedesktop theme name
# and follows its Inherits chain (Flat-Remix -> Adwaita -> hicolor) for fallback.
icon_theme = "Flat-Remix-Blue-Dark"
# icon_path is the legacy mechanism; unused when icon_theme + recursive lookup is set.
# icon_path = /home/duane/.icons/Boston/16/status/:/home/duane/.icons/Boston/16/devices/
icon_position = left
min_icon_size = 28
max_icon_size = 32

### History
sticky_history = yes
history_length = 50

### Apps
dmenu = /usr/bin/dmenu -p dunst:
browser = /usr/bin/xdg-open
always_run_script = true
title = Dunst
class = Dunst
ignore_dbusclose = false

### Wayland
# layer = top
force_xwayland = false

### Legacy X11 Compatibility
force_xinerama = false

### Mouse Actions
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

[experimental]
per_monitor_dpi = false

# Theme -------------------------------------------------------------
# Matches the quickshell bar (tundra) + i3 windows: base bg #1a1b26,
# text tundra white #E6EDF3, per-urgency accent frames in the tundra
# palette (low=green, normal=blue, critical=red), muted 50% toward grey
# so the frames aren't too bright.
#--------------------------------------------------------------------

# Default accent (normal-urgency blue) - used before an urgency section applies.
frame_color = "#6A749F"
highlight = "#6A749F"

[urgency_low]
    background = "#1a1b26"
    foreground = "#E6EDF3"
    frame_color = "#6C7D7A"
    highlight = "#6C7D7A"
    timeout = 5

[urgency_normal]
    background = "#1a1b26"
    foreground = "#E6EDF3"
    frame_color = "#6A749F"
    highlight = "#6A749F"
    timeout = 8

[urgency_critical]
    background = "#1a1b26"
    foreground = "#E6EDF3"
    frame_color = "#9E6A6E"
    highlight = "#9E6A6E"
    timeout = 0
