pkgname=falconia
pkgver=0.1.2
pkgrel=1
pkgdesc='Terminal based installer for BerserkArch'
arch=('any')
url='https://github.com/berserkarch/falconia'
license=(GPLv3)
depends=(go)

source=(
  "${pkgname}-linux-amd64::https://github.com/berserkarch/falconia/releases/download/v${pkgver}/${pkgname}-linux-amd64"
)

sha256sums=('f8889f36dc3a0e1b2b05044d069713cef398a4826ec1b58a8972a735cb723864')

package() {
  cd "$srcdir"

  install -Dm755 ${pkgname}-linux-amd64 "$pkgdir/usr/bin/falconia"
}
